#!/bin/sh
# Hook pre-push : bloque le push si le numero de version (package.json) n'a pas change
# depuis le dernier push sur main - pour ne plus jamais perdre le fil de "quelle version
# tourne sur quel appareil" (cf. CLAUDE.md section "Numero de version").
# Active une fois par clone via :
#   git config core.hooksPath .githooks

cd "$(dirname "$0")/.." || exit 1

# Capture immediate du stdin (les refs a pousser, fournies par git) - avant tout le reste,
# pour ne jamais risquer qu'un sous-processus le consomme en premier.
REFS=$(cat)

extract_version() {
  sed -nE 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' | head -1
}
ZERO="0000000000000000000000000000000000000000"

# Compare les DEUX blobs committes (git show $sha:package.json), jamais le working tree :
# un bump fait mais pas encore committe ne doit pas compter comme valide.
# Le heredoc (et non un pipe) garde la boucle dans le shell courant : dans un sous-shell,
# `exit 1` ne terminerait que le sous-shell et le hook sortirait en code 0.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue   # branche de DESTINATION, pas local_ref
  [ "$remote_sha" = "$ZERO" ] && continue             # nouvelle branche, rien a comparer
  [ "$local_sha" = "$ZERO" ] && continue              # suppression de branche (push --delete)

  new_version=$(git show "$local_sha:package.json" 2>/dev/null | extract_version)
  if [ -z "$new_version" ]; then
    echo "Impossible de lire \"version\" dans package.json pour ce push - push annule." >&2
    exit 1
  fi

  old_version=$(git show "$remote_sha:package.json" 2>/dev/null | extract_version)
  if [ -z "$old_version" ]; then
    continue   # fail-open : edge case sans rapport (ex. package.json inexistant a l'epoque)
  fi

  if [ "$old_version" = "$new_version" ]; then
    echo "Version inchangee (${new_version}) depuis le dernier push sur main - lance 'bash bump-version.sh' avant de committer." >&2
    exit 1
  fi
done <<EOF
$REFS
EOF

exit 0
